{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diffgloss",
  "version": "0.3.0",
  "identifier": "com.atomsprout.diffgloss",
  "build": {
    "frontendDist": "../dist-loading"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Diffgloss — Explainability-First Code Review Workbench",
        "width": 1380,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/diffgloss-engine"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
