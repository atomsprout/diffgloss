{
  "name": "diffgloss",
  "version": "0.2.0",
  "description": "Explainability-first code review ledger: verifiable per-hunk coverage, evidence-backed explanations, symmetric-proof review, and interactive browser diff tours.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "diffgloss": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "skills",
    "evals",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "eval": "bun run src/cli.ts eval",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
